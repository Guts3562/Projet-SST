FROM node:20-alpine

# Install system dependencies that might be required
RUN apk add --no-cache git python3 make g++

WORKDIR /app

# Copy package configurations
COPY package*.json ./
COPY server/package*.json ./server/

# Install root and server dependencies
RUN npm install
RUN cd server && npm install

# Copy all project files
COPY . .

# Expose Vite, Express backend, and n8n ports
EXPOSE 5173 5000 5678

# Run the concurrent dev script
CMD ["npm", "run", "dev"]
