FROM node:20-alpine

# Install system dependencies that might be required
RUN apk add --no-cache git python3 py3-setuptools make g++

WORKDIR /app

# Copy package configurations
COPY package*.json ./
COPY server/package*.json ./server/

# Install root and server dependencies
RUN npm install
RUN cd server && npm install

# Copy all project files
COPY . .

# Expose Vite frontend and Express backend ports
EXPOSE 5173 5000

# Run the dev server (Vite + Express backend)
CMD ["npm", "run", "start:docker"]
